# ELEVORA AI - Environment Variables Configuration
# Copy this file to .env and configure your variables

# Server configuration
PORT=8000
HOST=0.0.0.0

# Optional: Google Gemini AI API Key for live AI Career Guidance
# Get an API key from Google AI Studio: https://aistudio.google.com/
# If left blank, Elevora AI automatically uses its robust built-in rule-based heuristic engine
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
